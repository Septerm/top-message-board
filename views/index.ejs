<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Board</title>
</head>
<body>
    <h1>All Messages</h1>
    
    <%  for (let i = 0; i < messages.length; i++) { %>
        <div>
            <h2><%= messages[i].user %></h2>
            <p><%= messages[i].text %></p>
            <p><%= messages[i].added %></p>
        </div>
    <% } %>

    <p><a href="/new">new message</a></p>
</body>
</html>